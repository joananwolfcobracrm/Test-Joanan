# Curtain wall object for magicplan
# 1 unit = 1mm
# Pivot: center of backside (0, 0, 875)
# Back at Y=0 (wall), curtain extends toward -Y
# X: -700 to 700 (1400mm width)
# Z: 0 to 1750 (1750mm height)

# === LEFT CURTAIN PANEL ===
v -700 0 0
v -30 0 0
v -30 0 1750
v -700 0 1750
v -700 -5 0
v -30 -5 0
v -30 -5 1750
v -700 -5 1750

# === RIGHT CURTAIN PANEL ===
v 30 0 0
v 700 0 0
v 700 0 1750
v 30 0 1750
v 30 -5 0
v 700 -5 0
v 700 -5 1750
v 30 -5 1750

# === CURTAIN ROD ===
v -720 0 1760
v 720 0 1760
v 720 0 1780
v -720 0 1780
v -720 -15 1760
v 720 -15 1760
v 720 -15 1780
v -720 -15 1780

# Left panel - back face (wall side, normal +Y)
f 4 3 2 1
# Left panel - front face (room side, normal -Y)
f 5 6 7 8
# Left panel - top edge
f 4 8 7 3
# Left panel - bottom edge
f 1 2 6 5
# Left panel - left edge
f 1 5 8 4
# Left panel - right edge
f 2 3 7 6

# Right panel - back face
f 12 11 10 9
# Right panel - front face
f 13 14 15 16
# Right panel - top edge
f 12 16 15 11
# Right panel - bottom edge
f 9 10 14 13
# Right panel - left edge
f 9 13 16 12
# Right panel - right edge
f 10 11 15 14

# Rod - back face
f 20 19 18 17
# Rod - front face
f 21 22 23 24
# Rod - top face
f 20 24 23 19
# Rod - bottom face
f 17 18 22 21
# Rod - left face
f 17 21 24 20
# Rod - right face
f 18 19 23 22
