# Curtain wall object for magicplan
# 1 unit = 1mm
# Bounding box matches magicplan dimensions exactly:
#   Width (X): 1400mm (-700 to 700)
#   Depth (Y): 50mm (0 to -50)
#   Height (Z): 1750mm (0 to 1750)

# === LEFT CURTAIN PANEL ===
v -700 0 0
v -30 0 0
v -30 0 1700
v -700 0 1700
v -700 -50 0
v -30 -50 0
v -30 -50 1700
v -700 -50 1700

# === RIGHT CURTAIN PANEL ===
v 30 0 0
v 700 0 0
v 700 0 1700
v 30 0 1700
v 30 -50 0
v 700 -50 0
v 700 -50 1700
v 30 -50 1700

# === CURTAIN ROD ===
v -700 0 1700
v 700 0 1700
v 700 0 1750
v -700 0 1750
v -700 -50 1700
v 700 -50 1700
v 700 -50 1750
v -700 -50 1750

# Left panel faces
f 4 3 2 1
f 5 6 7 8
f 4 8 7 3
f 1 2 6 5
f 1 5 8 4
f 2 3 7 6

# Right panel faces
f 12 11 10 9
f 13 14 15 16
f 12 16 15 11
f 9 10 14 13
f 9 13 16 12
f 10 11 15 14

# Rod faces
f 20 19 18 17
f 21 22 23 24
f 20 24 23 19
f 17 18 22 21
f 17 21 24 20
f 18 19 23 22
