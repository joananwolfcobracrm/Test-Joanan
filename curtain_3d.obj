# Curtain - Wall Object
# 1 unit = 1mm
# Back at Y=0 (wall), front at Y=-5

# Left panel
v -700 -5 0
v -20 -5 0
v -20 -5 1750
v -700 -5 1750

# Right panel
v 20 -5 0
v 700 -5 0
v 700 -5 1750
v 20 -5 1750

# Curtain rod
v -720 0 1755
v 720 0 1755
v 720 0 1775
v -720 0 1775
v -720 -12 1755
v 720 -12 1755
v 720 -12 1775
v -720 -12 1775

# Normals
vn 0 -1 0
vn 0 1 0
vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0

# Left panel front
f 1//1 2//1 3//1
f 1//1 3//1 4//1
# Left panel back
f 2//2 1//2 4//2
f 2//2 4//2 3//2

# Right panel front
f 5//1 6//1 7//1
f 5//1 7//1 8//1
# Right panel back
f 6//2 5//2 8//2
f 6//2 8//2 7//2

# Rod back
f 9//2 10//2 11//2
f 9//2 11//2 12//2
# Rod front
f 14//1 13//1 16//1
f 14//1 16//1 15//1
# Rod bottom
f 9//4 13//4 14//4
f 9//4 14//4 10//4
# Rod top
f 12//3 11//3 15//3
f 12//3 15//3 16//3
# Rod left
f 9//6 12//6 16//6
f 9//6 16//6 13//6
# Rod right
f 10//5 14//5 15//5
