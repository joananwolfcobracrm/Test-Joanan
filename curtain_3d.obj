# Curtain wall object for magicplan
# 1 unit = 1mm
# Pivot at (0, 0, 0) = bottom-center of backside
# X: -700 to 700 (width 1400, centered)
# Y: 0 to -50 (depth 50, back at wall Y=0)
# Z: 0 to 1750 (height 1750, bottom at 0)

# Left panel
v -700 0 0
v -20 0 0
v -20 0 1750
v -700 0 1750
v -700 -50 0
v -20 -50 0
v -20 -50 1750
v -700 -50 1750

# Right panel
v 20 0 0
v 700 0 0
v 700 0 1750
v 20 0 1750
v 20 -50 0
v 700 -50 0
v 700 -50 1750
v 20 -50 1750

# Left panel faces
f 1 2 3 4
f 8 7 6 5
f 4 3 7 8
f 5 6 2 1
f 5 1 4 8
f 2 6 7 3

# Right panel faces
f 9 10 11 12
f 16 15 14 13
f 12 11 15 16
f 13 14 10 9
f 13 9 12 16
f 10 14 15 11
